{
  "version": 8,
  "name": "Benin Modern Style - Enhanced",
  "sources": {
    "benin": {
      "type": "vector",
      "tiles": [
        "http://localhost:8000/services/benin/tiles/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f5f3f0"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "benin",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#e0f0e0",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "benin",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#ebe8e0",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "benin",
      "source-layer": "park",
      "paint": {
        "fill-color": "#c8e6c9",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "benin",
      "source-layer": "water",
      "paint": {
        "fill-color": "#8ec4db"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "benin",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#8ec4db",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          0.8,
          14,
          3
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "benin",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#d9d0c7",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "building_outline",
      "type": "line",
      "source": "benin",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "line-color": "#c0b8af",
        "line-width": 0.5
      }
    },
    {
      "id": "road_casing",
      "type": "line",
      "source": "benin",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#b0aca0",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          5,
          1.5,
          10,
          5,
          14,
          14
        ],
        "line-opacity": 1
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "benin",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          5,
          1,
          10,
          3.5,
          14,
          11
        ]
      }
    },
    {
      "id": "place_label",
      "type": "symbol",
      "source": "benin",
      "source-layer": "place",
      "layout": {
        "text-field": "{name}",
        "text-font": ["Open Sans Semibold"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4,
          12,
          10,
          20
        ]
      },
      "paint": {
        "text-color": "#1a1a1a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2.5,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "road_label",
      "type": "symbol",
      "source": "benin",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "text-field": "{name}",
        "text-font": ["Open Sans Regular"],
        "text-size": 11,
        "symbol-placement": "line",
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "#4a4a4a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2.5
      }
    }
  ]
}
