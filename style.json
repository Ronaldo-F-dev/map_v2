{
  "version": 8,
  "name": "Benin Modern Style - Simple",
  "sources": {
    "benin": {
      "type": "vector",
      "tiles": [
        "http://localhost:8000/services/benin/tiles/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8f4f0"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "benin",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#e8f5e9",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "benin",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#f0ede8",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "benin",
      "source-layer": "park",
      "paint": {
        "fill-color": "#d4edda",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "benin",
      "source-layer": "water",
      "paint": {
        "fill-color": "#aad3df"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "benin",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#aad3df",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          0.5,
          14,
          2
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "benin",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#e0dcd8",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "building_outline",
      "type": "line",
      "source": "benin",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "line-color": "#d0ccc8",
        "line-width": 0.5
      }
    },
    {
      "id": "road_casing",
      "type": "line",
      "source": "benin",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#c7c3b8",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          5,
          1.2,
          10,
          4,
          14,
          12
        ],
        "line-opacity": 0.8
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "benin",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          5,
          0.8,
          10,
          3,
          14,
          9
        ]
      }
    },
    {
      "id": "place_label_city",
      "type": "symbol",
      "source": "benin",
      "source-layer": "place",
      "filter": ["==", ["get", "place"], "city"],
      "layout": {
        "text-field": ["get", "name:latin"],
        "text-font": ["Open Sans Bold"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4,
          14,
          10,
          22
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#2c2c2c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2,
        "text-halo-blur": 1
      }
    },
    {
      "id": "place_label_town",
      "type": "symbol",
      "source": "benin",
      "source-layer": "place",
      "filter": ["==", ["get", "place"], "town"],
      "layout": {
        "text-field": ["get", "name:latin"],
        "text-font": ["Open Sans Semibold"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          12,
          12,
          20
        ]
      },
      "paint": {
        "text-color": "#404040",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2,
        "text-halo-blur": 0.8
      }
    },
    {
      "id": "place_label_village",
      "type": "symbol",
      "source": "benin",
      "source-layer": "place",
      "filter": [
        "in",
        ["get", "place"],
        ["literal", ["village", "hamlet"]]
      ],
      "minzoom": 10,
      "layout": {
        "text-field": ["get", "name:latin"],
        "text-font": ["Open Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          10,
          14,
          16
        ]
      },
      "paint": {
        "text-color": "#505050",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "road_label",
      "type": "symbol",
      "source": "benin",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "text-field": ["get", "name:latin"],
        "text-font": ["Open Sans Regular"],
        "text-size": 11,
        "symbol-placement": "line",
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "#5c5c5c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    }
  ]
}
